<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HalloweenBus</title>

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#121212;
color:white;
}

header{
background:linear-gradient(90deg,#ff7b00,#ffae00);
padding:30px;
text-align:center;
}

nav{
background:#1e1e1e;
padding:15px;
text-align:center;
}

nav a{
color:#ffae00;
text-decoration:none;
margin:15px;
font-weight:bold;
}

.hero{
padding:80px 20px;
text-align:center;
}

.hero h1{
font-size:3rem;
}

.btn{
background:#ff7b00;
color:white;
padding:12px 24px;
border:none;
border-radius:8px;
cursor:pointer;
font-size:18px;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
padding:40px;
}

.card{
background:#222;
padding:20px;
border-radius:12px;
}

.card img{
width:100%;
border-radius:10px;
}

.likes{
margin-top:10px;
}

.contact{
padding:40px;
text-align:center;
}

input,textarea{
width:80%;
max-width:500px;
padding:10px;
margin:10px;
border-radius:8px;
border:none;
}

footer{
background:#1e1e1e;
padding:20px;
text-align:center;
}
</style>
</head>

<body>

<header>
<h1>🎃 HalloweenBus</h1>
<p>Your Art on Slatina's Rides</p>
</header>

<nav>
#galleryGallery</a>
#communityCommunity</a>
#contactContact</a>
</nav>

<section class="hero">
<h1>Welcome Artists!</h1>
<p>Share spooky bus-themed artwork from Slatina.</p>
<button class="btn">Join Community</button>
</section>

<section id="gallery">

<h2 style="text-align:center;">🎨 Featured Artwork</h2>

<div class="gallery">

<div class="card">
https://picsum.photos/400/250?1
<h3>Pumpkin Bus</h3>
<p>A Halloween themed city bus.</p>
<button onclick="like1()">❤️ Like</button>
<span id="l1">0</span>
</div>

<div class="card">
https://picsum.photos/400/250?2
<h3>Night Route</h3>
<p>Spooky evening service.</p>
<button onclick="like2()">❤️ Like</button>
<span id="l2">0</span>
</div>

<div class="card">
https://picsum.photos/400/250?3
<h3>Ghost Stop</h3>
<p>A haunted bus station design.</p>
<button onclick="like3()">❤️ Like</button>
<span id="l3">0</span>
</div>

</div>

</section>

<section id="community" style="padding:40px;text-align:center;">
<h2>💬 Community Board</h2>

<textarea id="message" placeholder="Write something..."></textarea><br>

<button class="btn" onclick="postMessage()">Post</button>

<div id="messages"></div>

</section>

<section id="contact" class="contact">

<h2>📩 Contact</h2>

<form>
<input type="text" placeholder="Your Name"><br>
<input type="email" placeholder="Your Email"><br>
<textarea placeholder="Message"></textarea><br>
<button class="btn">Send</button>
</form>

</section>

<footer>
© HalloweenBus 2026
</footer>

<script>

let a=0;
let b=0;
let c=0;

function like1(){
a++;
document.getElementById("l1").innerText=a;
}

function like2(){
b++;
document.getElementById("l2").innerText=b;
}

function like3(){
c++;
document.getElementById("l3").innerText=c;
}

function postMessage(){

let text=document.getElementById("message").value;

if(text.trim()=="") return;

let item=document.createElement("p");

item.innerHTML="🚌 "+text;

document.getElementById("messages").appendChild(item);

document.getElementById("message").value="";
}
</script>

</body>
</html>
